import { Theme } from "theme.slint";
import { Spinner } from "std-widgets.slint";

export component Icon inherits Image {
    in property <color> color: Theme.text-2;
    in property <length> size: 18px;
    width: size;
    height: size;
    colorize: color;
    image-fit: contain;
}

// Botão principal da UI. variant: primary | secondary | ghost | danger | soft | success
export component Btn inherits Rectangle {
    in property <string> text;
    in property <image> icon;
    in property <bool> has-icon: false;
    in property <string> variant: "secondary";
    in property <bool> loading: false;
    in property <bool> enabled: true;
    in property <bool> small: false;
    callback clicked;
    property <bool> active: enabled && !loading;
    property <color> fg: variant == "primary" || variant == "success" ? #FFFFFF
        : variant == "danger" ? Theme.danger
        : variant == "soft" ? Theme.primary
        : Theme.text;
    height: small ? 30px : 36px;
    min-width: small ? 30px : 36px;
    border-radius: Theme.radius-sm;
    opacity: enabled ? 1 : 0.5;
    background: variant == "primary" ? (ta.has-hover && active ? Theme.primary-hover : Theme.primary)
        : variant == "success" ? (ta.has-hover && active ? #15803D : Theme.success)
        : variant == "danger" ? (ta.has-hover && active ? Theme.danger-soft.darker(5%) : Theme.danger-soft)
        : variant == "soft" ? (ta.has-hover && active ? Theme.primary-soft.darker(4%) : Theme.primary-soft)
        : variant == "ghost" ? (ta.has-hover && active ? Theme.surface-hover : transparent)
        : (ta.has-hover && active ? Theme.surface-hover : Theme.surface);
    border-width: variant == "secondary" ? 1px : 0px;
    border-color: Theme.border-strong;
    drop-shadow-blur: variant == "primary" && ta.has-hover ? 10px : 0px;
    drop-shadow-color: variant == "primary" && ta.has-hover ? #5B5BF055 : transparent;
    drop-shadow-offset-y: variant == "primary" && ta.has-hover ? 2px : 0px;
    animate background, drop-shadow-blur { duration: 120ms; }

    HorizontalLayout {
        padding-left: root.text == "" ? 0px : (small ? 10px : 14px);
        padding-right: self.padding-left;
        spacing: 7px;
        alignment: center;
        if loading: Spinner {
            width: 14px;
            height: 14px;
            indeterminate: true;
            y: (parent.height - self.height) / 2;
        }
        if has-icon && !loading: Icon {
            source: root.icon;
            color: root.fg;
            size: small ? 14px : 16px;
            y: (parent.height - self.height) / 2;
        }
        if root.text != "": Text {
            text: root.text;
            color: root.fg;
            font-size: small ? Theme.font-sm : Theme.font;
            font-weight: 600;
            vertical-alignment: center;
        }
    }
    ta := TouchArea {
        mouse-cursor: active ? pointer : default;
        clicked => { if (active) { root.clicked(); } }
    }
}

// Botão só com ícone e tooltip.
export component IconBtn inherits Rectangle {
    in property <image> icon;
    in property <string> tip;
    in property <bool> selected: false;
    in property <bool> enabled: true;
    in property <color> tint: Theme.text-2;
    in property <length> size: 38px;
    in property <bool> tip-left: false;
    callback clicked;
    width: size;
    height: size;
    border-radius: Theme.radius-sm;
    opacity: enabled ? 1 : 0.4;
    background: selected ? Theme.primary-soft : ta.has-hover && enabled ? Theme.surface-hover : transparent;
    animate background { duration: 100ms; }
    Icon {
        source: root.icon;
        color: root.selected ? Theme.primary : root.tint;
        size: root.size * 0.47;
    }
    ta := TouchArea {
        mouse-cursor: enabled ? pointer : default;
        clicked => { if (enabled) { root.clicked(); } }
    }
    if ta.has-hover && root.tip != "": Rectangle {
        x: root.tip-left ? -self.width - 8px : (parent.width - self.width) / 2;
        y: root.tip-left ? (parent.height - self.height) / 2 : parent.height + 6px;
        width: tipt.preferred-width + 16px;
        height: 26px;
        border-radius: 6px;
        background: #161A26;
        drop-shadow-blur: 8px;
        drop-shadow-color: #00000040;
        tipt := Text { text: root.tip; color: white; font-size: Theme.font-sm; }
    }
}

// kind: neutral | primary | success | warning | danger | info
export component Chip inherits Rectangle {
    in property <string> text;
    in property <string> kind: "neutral";
    in property <bool> dot: false;
    in property <bool> pulse: false;
    property <color> fg: kind == "primary" ? Theme.primary : kind == "success" ? Theme.success
        : kind == "warning" ? Theme.warning : kind == "danger" ? Theme.danger : kind == "info" ? Theme.info : Theme.text-2;
    height: 22px;
    horizontal-stretch: 0;
    border-radius: 11px;
    background: kind == "primary" ? Theme.primary-soft : kind == "success" ? Theme.success-soft
        : kind == "warning" ? Theme.warning-soft : kind == "danger" ? Theme.danger-soft
        : kind == "info" ? Theme.info-soft : Theme.surface-2;
    border-width: kind == "neutral" ? 1px : 0px;
    border-color: Theme.border;
    HorizontalLayout {
        padding-left: 9px;
        padding-right: 9px;
        spacing: 5px;
        if dot: Rectangle {
            width: 7px;
            height: 7px;
            y: (parent.height - 7px) / 2;
            border-radius: 3.5px;
            background: root.fg;
            opacity: root.pulse ? 0.35 + 0.65 * abs(sin(animation-tick() / 700ms * 180deg)) : 1;
        }
        Text {
            text: root.text;
            color: root.fg;
            font-size: Theme.font-xs;
            font-weight: 600;
            vertical-alignment: center;
            overflow: elide;
        }
    }
}

// Barra de progresso (progress < 0 = indeterminada, com animação).
export component Progress inherits Rectangle {
    in property <float> progress: -1;
    in property <color> bar-color: Theme.primary;
    in property <length> thickness: 6px;
    height: thickness;
    border-radius: thickness / 2;
    background: Theme.surface-hover;
    clip: true;
    property <float> t: mod(animation-tick() / 1400ms, 1);
    Rectangle {
        x: root.progress < 0 ? (root.t * 1.4 - 0.4) * root.width : 0;
        width: root.progress < 0 ? root.width * 0.4 : root.width * clamp(root.progress, 0, 1);
        height: root.height;
        border-radius: root.thickness / 2;
        background: root.bar-color == Theme.primary ? Theme.brand : root.bar-color;
        animate width { duration: 200ms; }
    }
}

export component Card inherits Rectangle {
    in property <bool> hoverable: false;
    in property <length> pad: 18px;
    out property <bool> hovered: ht.has-hover;
    background: Theme.surface;
    border-radius: Theme.radius-lg;
    border-width: 1px;
    border-color: hoverable && ht.has-hover ? Theme.border-strong : Theme.border;
    drop-shadow-blur: hoverable && ht.has-hover ? 22px : 6px;
    drop-shadow-offset-y: hoverable && ht.has-hover ? 6px : 1px;
    drop-shadow-color: Theme.shadow;
    animate drop-shadow-blur, drop-shadow-offset-y, border-color { duration: 160ms; }
    ht := TouchArea { }
    @children
}

export component SectionTitle inherits VerticalLayout {
    in property <string> title;
    in property <string> subtitle;
    spacing: 2px;
    Text { text: root.title; font-size: Theme.font-lg; font-weight: 700; color: Theme.text; }
    if root.subtitle != "": Text { text: root.subtitle; font-size: Theme.font-sm; color: Theme.text-3; wrap: word-wrap; }
}

// Linha de formulário: rótulo à esquerda, controle à direita.
export component FieldRow inherits HorizontalLayout {
    in property <string> label;
    in property <string> hint;
    spacing: 16px;
    min-height: 40px;
    VerticalLayout {
        alignment: center;
        horizontal-stretch: 1;
        spacing: 1px;
        Text { text: root.label; color: Theme.text; font-size: Theme.font; font-weight: 600; }
        if root.hint != "": Text { text: root.hint; color: Theme.text-3; font-size: Theme.font-xs; wrap: word-wrap; }
    }
    HorizontalLayout {
        alignment: end;
        horizontal-stretch: 1;
        spacing: 8px;
        @children
    }
}

export component Divider inherits Rectangle {
    height: 1px;
    background: Theme.border;
}

// Controle segmentado.
export component Segmented inherits Rectangle {
    in property <[string]> items;
    in-out property <int> selected;
    callback changed(int);
    height: 34px;
    border-radius: Theme.radius-sm;
    background: Theme.surface-hover;
    HorizontalLayout {
        padding: 3px;
        spacing: 2px;
        for it[i] in root.items: Rectangle {
            border-radius: 6px;
            background: i == root.selected ? Theme.surface : transparent;
            drop-shadow-blur: i == root.selected ? 4px : 0px;
            drop-shadow-color: i == root.selected ? Theme.shadow : transparent;
            animate background { duration: 120ms; }
            HorizontalLayout {
                padding-left: 12px;
                padding-right: 12px;
                Text {
                    text: it;
                    color: i == root.selected ? Theme.text : Theme.text-2;
                    font-size: Theme.font-sm;
                    font-weight: i == root.selected ? 700 : 500;
                    vertical-alignment: center;
                    horizontal-alignment: center;
                }
            }
            TouchArea {
                mouse-cursor: pointer;
                clicked => { root.selected = i; root.changed(i); }
            }
        }
    }
}

// Indicador de estado vazio com ícone.
export component EmptyState inherits VerticalLayout {
    in property <image> icon;
    in property <string> title;
    in property <string> text;
    alignment: center;
    spacing: 10px;
    HorizontalLayout {
        alignment: center;
        Rectangle {
            width: 72px;
            height: 72px;
            border-radius: 36px;
            background: Theme.primary-soft;
            Icon { source: root.icon; color: Theme.primary; size: 32px; }
        }
    }
    Text { text: root.title; font-size: Theme.font-lg; font-weight: 700; color: Theme.text; horizontal-alignment: center; }
    Text { text: root.text; font-size: Theme.font; color: Theme.text-3; horizontal-alignment: center; wrap: word-wrap; }
    @children
}

// Esqueleto animado (carregamento).
export component Skeleton inherits Rectangle {
    border-radius: 6px;
    background: Theme.surface-hover;
    opacity: 0.55 + 0.45 * abs(sin(animation-tick() / 900ms * 180deg));
}

// Miniatura de um aparelho, com proporção real da tela.
export component DeviceShape inherits Rectangle {
    in property <float> aspect: 0.5;
    in property <string> kind: "phone";
    in property <bool> on: false;
    in property <length> box: 64px;
    width: box;
    height: box;
    property <length> h: aspect >= 1 ? box * 0.62 / aspect * 1.0 : box;
    property <length> w: aspect >= 1 ? box * 0.95 : box * aspect;
    Rectangle {
        width: kind == "wear" ? root.box * 0.8 : root.w;
        height: kind == "wear" ? root.box * 0.8 : (root.aspect >= 1 ? root.w / root.aspect : root.h);
        border-radius: kind == "wear" ? self.width / 2 : (kind == "tv" ? 4px : 8px);
        background: #1F2333;
        Rectangle {
            x: 3px;
            y: 3px;
            width: parent.width - 6px;
            height: parent.height - 6px;
            border-radius: kind == "wear" ? self.width / 2 : (kind == "tv" ? 2px : 6px);
            background: root.on ? Theme.brand : @linear-gradient(160deg, #3A4060 0%, #262A3D 100%);
            animate background { duration: 300ms; }
        }
    }
}

export component Badge inherits Rectangle {
    in property <int> count;
    visible: count > 0;
    width: max(18px, t.preferred-width + 10px);
    height: 18px;
    border-radius: 9px;
    background: Theme.danger;
    t := Text { text: root.count; color: white; font-size: 10px; font-weight: 700; }
}
